typedef enum {
    AT_HOME,
    AT_BOOTH_QUEUE,
    AT_BOOTH,
    AT_SLIDE_QUEUE,
    RIDING_SLIDE,
    EXITED
} PersonStatus;

typedef enum {
    FREE,
    OCCUPIED
} FacilityStatus;

typedef struct Person {
    int id;
    PersonStatus status;
    int arrival_time;
    int entry_time;
    int exit_time;
    int booth_service_time;
    int booth_wait_time;
    int slide_wait_time;
    int slides_to_ride;
    int slides_ridden;
    struct Person* next;
} Person;

typedef struct Slide {
    int id;
    FacilityStatus status;
    int ride_time;
    int people_count;
    Person* queue;
    int ride_end_time;
} Slide;

typedef struct TicketBooth {
    int id;
    FacilityStatus status;
    int service_end_time;
    Person* queue;
} TicketBooth;

